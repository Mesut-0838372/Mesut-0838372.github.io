<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />


		<link rel="stylesheet" type="text/css" href="src/base.css"> <!--Source - https://stackoverflow.com/a/1947890 Posted by Pekka Retrieved 2026-09-15, License - CC BY-SA 2.5 -->
